rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCaregiver() {
      return isAuthenticated() && getUserData().role == 'caregiver';
    }

    function isDoctor() {
      return isAuthenticated() && getUserData().role == 'doctor' && getUserData().isApproved == true;
    }

    function isPaired(patientId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/pairs/$(request.auth.uid + '_' + patientId)) ||
        exists(/databases/$(database)/documents/pairs/$(patientId + '_' + request.auth.uid))
      );
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isCaregiver() || isDoctor());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Users cannot be deleted directly via client SDK
    }

    // Medications collection rules
    match /medications/{medicationId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isPaired(request.resource.data.patientId)
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
    }

    // Intake Logs collection rules
    match /intakeLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isPaired(request.resource.data.patientId)
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow delete: if false;
    }

    // Vital Signs collection rules
    match /vitalSigns/{vitalId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isPaired(request.resource.data.patientId)
      );
      allow update, delete: if false;
    }

    // Lab Reports collection rules
    match /labReports/{reportId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isPaired(request.resource.data.patientId)
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Pairing Codes (temporary 6-character codes)
    match /pairingCodes/{codeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Pairs collection rules
    match /pairs/{pairId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.caregiverId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.caregiverId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
    }

    // Emergency Alerts collection rules
    match /emergencyAlerts/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isPaired(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isPaired(request.resource.data.patientId)
      );
      allow update, delete: if false;
    }
  }
}
